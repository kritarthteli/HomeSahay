{
  "name": "sih-cooperative-gig-platform",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "customer": "cross-env APP_ROLE=customer EXPO_PUBLIC_APP_ROLE=customer expo start --port 8081",
    "worker": "cross-env APP_ROLE=worker EXPO_PUBLIC_APP_ROLE=worker expo start --port 8082",
    "admin": "cross-env APP_ROLE=admin EXPO_PUBLIC_APP_ROLE=admin expo start --port 8083",
    "web:customer": "cross-env APP_ROLE=customer EXPO_PUBLIC_APP_ROLE=customer expo start --web --port 8081",
    "web:worker": "cross-env APP_ROLE=worker EXPO_PUBLIC_APP_ROLE=worker expo start --web --port 8082",
    "web:admin": "cross-env APP_ROLE=admin EXPO_PUBLIC_APP_ROLE=admin expo start --web --port 8083",
    "android:customer": "cross-env APP_ROLE=customer EXPO_PUBLIC_APP_ROLE=customer expo start --android --port 8081",
    "android:worker": "cross-env APP_ROLE=worker EXPO_PUBLIC_APP_ROLE=worker expo start --android --port 8082",
    "android:admin": "cross-env APP_ROLE=admin EXPO_PUBLIC_APP_ROLE=admin expo start --android --port 8083",
    "ios:customer": "cross-env APP_ROLE=customer EXPO_PUBLIC_APP_ROLE=customer expo start --ios --port 8081",
    "ios:worker": "cross-env APP_ROLE=worker EXPO_PUBLIC_APP_ROLE=worker expo start --ios --port 8082",
    "ios:admin": "cross-env APP_ROLE=admin EXPO_PUBLIC_APP_ROLE=admin expo start --ios --port 8083"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.2.3",
    "@expo/vector-icons": "^14.0.2",
    "@react-native-community/slider": "^4.5.2",
    "expo": "~51.0.0",
    "expo-constants": "~16.0.2",
    "expo-font": "~12.0.10",
    "expo-linear-gradient": "~13.0.2",
    "expo-linking": "~6.3.1",
    "expo-router": "~3.5.0",
    "expo-splash-screen": "~0.27.5",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-maps": "1.14.0",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-svg": "15.2.0",
    "react-native-web": "~0.19.10",
    "react-native-webview": "13.8.6",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~18.2.79",
    "cross-env": "^10.1.0",
    "typescript": "~5.3.3"
  },
  "private": true
}
