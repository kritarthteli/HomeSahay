# Copy this file to .env and fill in real values.
# Never commit the real .env file — it is already in .gitignore.

PORT=5000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=homesahay

# Required. Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start without this set.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── Fair Matching / AI / Routing (matching-ai branch) ──────────────
# Ollama server used by services/aiService.js to parse natural-language
# requests. Optional: if unreachable, aiService falls back automatically
# to a deterministic keyword parser.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_MS=4000

# Set to "true" to skip Ollama entirely and always use the keyword
# fallback (useful for demos/dev machines without Ollama installed).
AI_MOCK_MODE=false

# OSRM-compatible routing server used by services/routingService.js.
# Optional: if unreachable, routingService falls back automatically to
# a Haversine-distance estimate.
OSRM_BASE_URL=http://localhost:5001
OSRM_TIMEOUT_MS=3000
